# Copy to ~/cupcakes/.env on the VM and fill in real values. Never commit the real file.
# Generate random values with: openssl rand -base64 32

# Public DNS name of the VM (placeholder: Azure VM > Overview > DNS name)
DOMAIN=cupcakes-demo.westeurope.cloudapp.azure.com

POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
SECRET_KEY=change-me

# Must match the secret of the cupcakes-web client in Keycloak.
# Regenerate it after the first start: Keycloak admin > Clients > cupcakes-web > Credentials
KEYCLOAK_CLIENT_SECRET=cupcakes-web-secret
