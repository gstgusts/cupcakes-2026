{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "env": {
        "FLASK_APP": "run.py",
        "FLASK_DEBUG": "1"
      },
      "args": ["run", "--no-debugger", "--no-reload"],
      "jinja": true,
      "justMyCode": true,
      // Starts PostgreSQL + Keycloak in Docker and builds the CSS before Flask starts
      "preLaunchTask": "Start dependencies"
    },
    {
      "name": "Flask (debug, skip dependencies)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "env": {
        "FLASK_APP": "run.py",
        "FLASK_DEBUG": "1"
      },
      "args": ["run", "--no-debugger", "--no-reload"],
      "jinja": true,
      "justMyCode": true
    }
  ]
}
