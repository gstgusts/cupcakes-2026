{
  "realm": "cupcakes",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "sslRequired": "external",
  "roles": {
    "realm": [
      { "name": "admin", "description": "Manages users and application settings" },
      { "name": "user", "description": "Regular user of the cupcake planning app" },
      { "name": "offline_access", "description": "${role_offline-access}" },
      { "name": "uma_authorization", "description": "${role_uma_authorization}" },
      {
        "name": "default-roles-cupcakes",
        "description": "Roles every new user gets",
        "composite": true,
        "composites": { "realm": ["offline_access", "uma_authorization", "user"] }
      }
    ]
  },
  "defaultRole": { "name": "default-roles-cupcakes" },
  "clients": [
    {
      "clientId": "cupcakes-web",
      "name": "Cupcakes Flask web app",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "cupcakes-web-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "rootUrl": "http://localhost:5000",
      "redirectUris": ["http://localhost:5000/auth/callback", "http://127.0.0.1:5000/auth/callback"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5000/*##http://127.0.0.1:5000/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "user1",
      "enabled": true,
      "email": "user1@example.com",
      "emailVerified": true,
      "firstName": "User",
      "lastName": "One",
      "realmRoles": ["default-roles-cupcakes", "admin"],
      "credentials": [{ "type": "password", "value": "sOhM^8s19eMp", "temporary": false }]
    },
    {
      "username": "user2",
      "enabled": true,
      "email": "user2@example.com",
      "emailVerified": true,
      "firstName": "User",
      "lastName": "Two",
      "realmRoles": ["default-roles-cupcakes"],
      "credentials": [{ "type": "password", "value": "R4hoc6C_oth2", "temporary": false }]
    },
    {
      "username": "user3",
      "enabled": true,
      "email": "user3@example.com",
      "emailVerified": true,
      "firstName": "User",
      "lastName": "Three",
      "realmRoles": ["default-roles-cupcakes"],
      "credentials": [{ "type": "password", "value": "5BRN7UC9Zs7@", "temporary": false }]
    }
  ]
}
